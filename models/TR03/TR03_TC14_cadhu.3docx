          <ocx:BulbOuterRadius numericvalue="0.013" unit="uMeter"/>
          <ocx:BulbInnerRadius numericvalue="0.013" unit="uMeter"/>
        </ocx:BulbFlat>
      </ocx:BarSection>
    </ocx:XSectionCatalogue>
  </ocx:ClassCatalogue>
