      </unitsml:Unit>
      <unitsml:Unit xml:id="uKG">
        <unitsml:UnitName xml:lang="en-us">
          KG
        </unitsml:UnitName>
        <unitsml:UnitSymbol type="kg"/>
        <unitsml:RootUnits>
          <unitsml:EnumeratedRootUnit unit="gram" powerNumerator="1" prefix="k"/>
        </unitsml:RootUnits>
      </unitsml:Unit>
      <unitsml:Unit xml:id="uKG_M3">
        <unitsml:UnitName xml:lang="en-us">
