        <unitsml:UnitSymbol type="Ra"/>
        <unitsml:RootUnits>
          <unitsml:EnumeratedRootUnit unit="radian" powerNumerator="1"/>
        </unitsml:RootUnits>
      </unitsml:Unit>
      <unitsml:Unit xml:id="uMm">
        <unitsml:UnitName xml:lang="en-us">
          millimeter
        </unitsml:UnitName>
        <unitsml:UnitSymbol type="mm"/>
        <unitsml:RootUnits>
          <unitsml:EnumeratedRootUnit unit="meter" powerNumerator="-3" prefix="m"/>
        </unitsml:RootUnits>
      </unitsml:Unit>
      <unitsml:Unit xml:id="uMeterPerSecond">
        <unitsml:UnitName xml:lang="en-us">
          meter per second
        </unitsml:UnitName>
        <unitsml:UnitSymbol type="m/s"/>
        <unitsml:RootUnits>
          <unitsml:EnumeratedRootUnit unit="meter" powerNumerator="1"/>
          <unitsml:EnumeratedRootUnit unit="second" powerNumerator="-1"/>
        </unitsml:RootUnits>
      </unitsml:Unit>
      <unitsml:Unit xml:id="uKnots">
        <unitsml:UnitName xml:lang="en-us">
          (Nautical) knots
        </unitsml:UnitName>
        <unitsml:UnitSymbol type="kn"/>
        <unitsml:RootUnits>
          <unitsml:EnumeratedRootUnit unit="knot" powerNumerator="1"/>
        </unitsml:RootUnits>
      </unitsml:Unit>
    </unitsml:UnitSet>
  </unitsml:UnitsML>
</ocx:ocxXML>